# Copy this file to backend/.env and fill in real values. Never commit backend/.env.
FLASK_APP=run.py
FLASK_ENV=development

# Generate long random values, e.g. python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me
JWT_SECRET_KEY=change-me-too

DATABASE_URL=sqlite:///quiz_master.db
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Gmail needs an App Password here, not your account password.
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=you@example.com
MAIL_PASSWORD=your-app-password

# Admin account created on first run.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me

FRONTEND_URL=http://localhost:8080
